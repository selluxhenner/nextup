{
  "name": "nextup",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.2.0",
  "scripts": {
    "dev": "npm run dev -w @nextup/app --",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "npm run e2e -w @nextup/app --",
    "e2e:db": "npm run e2e:db -w @nextup/app --",
    "e2e:live": "npm run e2e:live -w @nextup/app --",
    "db:migrate": "npm run db:migrate -w @nextup/app",
    "db:seed": "npm run db:seed -w @nextup/app"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
