# Alternative to Caddyfile when there is no hosttech API token.
#
# No wildcard certificate: Caddy issues an ordinary per-host cert on the first TLS handshake for
# each subdomain, over HTTP-01. The `ask` endpoint is what stops a stranger minting certificates
# by pointing DNS at the box - it returns 200 only for a company that exists.
#
# Trade-off: the very first visit to a brand-new subdomain pauses while the cert is issued, and
# the ask call sits on the TLS handshake path.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/tls-check
		interval 2m
		burst 5
	}
}

{$APP_DOMAIN}, *.{$APP_DOMAIN} {
	tls {
		on_demand
	}

	@n8n host n8n.{$APP_DOMAIN}
	@mail host mail.{$APP_DOMAIN}
	# Both are ops tools, not the product: nobody reaches them without the ops login. mailpit has
	# no login of its own, and n8n makes whoever opens it first its owner. An unset OPS_USER or
	# OPS_PASSWORD_HASH answers 401 to everyone - closed, never open.
	handle @n8n {
		basic_auth {
			{$OPS_USER} {$OPS_PASSWORD_HASH}
		}
		reverse_proxy n8n:5678
	}
	handle @mail {
		basic_auth {
			{$OPS_USER} {$OPS_PASSWORD_HASH}
		}
		reverse_proxy mailpit:8025
	}
	handle {
		reverse_proxy app:3000
	}

	encode zstd gzip
}
