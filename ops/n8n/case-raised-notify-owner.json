{
  "name": "NextUp — case raised → notify route owner",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nextup/case-raised",
        "responseMode": "onReceived",
        "responseCode": 202,
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Case raised (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, 0],
      "webhookId": "nextup-case-raised",
      "notes": "The app POSTs here after the event row commits. Header auth checks X-NextUp-Token against N8N_HOOK_TOKEN."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={{ $json.body.type }}",
              "rightValue": "case.raised"
            },
            {
              "id": "c2",
              "operator": { "type": "string", "operation": "exists", "singleValue": true },
              "leftValue": "={{ $json.body.route.ownerEmail }}",
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Is a raise with an owner?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-140, 0],
      "notes": "Guards against a mis-wired caller, and against a company whose routing table has no owner for this route."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "subject",
              "type": "string",
              "value": "=New case on your desk: {{ $json.body.case.title }}"
            },
            {
              "id": "s2",
              "name": "text",
              "type": "string",
              "value": "={{ $json.body.route.ownerName }},\n\nsomeone raised this and it is on your desk:\n\n  {{ $json.body.case.title }}\n\n  {{ $json.body.case.body }}\n\nRoute: {{ $json.body.route.label }}\nAnswer by day {{ $json.body.case.dueDay }} — yes, no with a reason, hand it over, or ask a question.\n\nOpen the inbox: {{ $json.body.links.inbox }}\nThis case:      {{ $json.body.links.case }}\n\nIf you cannot take it, {{ $json.body.route.deputyName }} is the deputy."
            },
            {
              "id": "s3",
              "name": "to",
              "type": "string",
              "value": "={{ $json.body.route.ownerEmail }}"
            },
            {
              "id": "s4",
              "name": "slug",
              "type": "string",
              "value": "={{ $json.body.slug }}"
            },
            {
              "id": "s5",
              "name": "caseId",
              "type": "string",
              "value": "={{ $json.body.case.id }}"
            },
            {
              "id": "s6",
              "name": "eventId",
              "type": "string",
              "value": "={{ $json.body.eventId }}"
            },
            {
              "id": "s7",
              "name": "apiBase",
              "type": "string",
              "value": "={{ $json.body.apiBase }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Compose the message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [100, -100],
      "notes": "Every sentence is built here from facts the app sent. Nothing is read back out of the database."
    },
    {
      "parameters": {
        "fromEmail": "nextup@localhost",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Email the owner",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [320, -100],
      "credentials": {},
      "onError": "continueRegularOutput",
      "notes": "SMTP credential `<slug>-smtp`. In the compose stack this points at mailpit:1025, so nothing leaves the box and the whole team can read the inbox at mail.<domain>. Swap the credential for real SMTP per customer. Continue-on-fail: a bounced mail must not stop the write-back below."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Compose the message').item.json.apiBase }}/api/{{ $('Compose the message').item.json.slug }}/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Idempotency-Key", "value": "=notify:{{ $('Compose the message').item.json.eventId }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"case.commented\",\n  \"target\": \"{{ $('Compose the message').item.json.caseId }}\",\n  \"payload\": { \"text\": \"Route owner notified by email.\" }\n}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Write it back to the case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, -100],
      "credentials": {},
      "notes": "The money shot: the notification shows up in the case timeline. In-network (http://app:3000), bearer credential `<slug>-nextup`. The Idempotency-Key is the event id, so re-running this workflow never doubles the comment - POST answers 200 with duplicate:true and writes no row."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "n1",
              "name": "skipped",
              "type": "string",
              "value": "=No route owner for {{ $json.body.case.routeId }} in {{ $json.body.slug }} — nothing to notify."
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Nothing to do",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [100, 120],
      "notes": "Visible in the execution log rather than failing - an unrouted case is normal early in a pilot."
    }
  ],
  "connections": {
    "Case raised (webhook)": {
      "main": [[{ "node": "Is a raise with an owner?", "type": "main", "index": 0 }]]
    },
    "Is a raise with an owner?": {
      "main": [
        [{ "node": "Compose the message", "type": "main", "index": 0 }],
        [{ "node": "Nothing to do", "type": "main", "index": 0 }]
      ]
    },
    "Compose the message": {
      "main": [[{ "node": "Email the owner", "type": "main", "index": 0 }]]
    },
    "Email the owner": {
      "main": [[{ "node": "Write it back to the case", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "instanceId": "nextup-pilot" },
  "tags": [{ "name": "nextup" }]
}
