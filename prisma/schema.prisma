// The server-side store. Phase 2 of docs/PLAN.md; the tables docs/DATA_MODEL.md asks for, minus
// the ones the demo seed still covers (see below).
//
// Deliberate scope: only what has to be SHARED between people or QUERIED lives here. The rich
// per-company content - departments, the org chart, the routing table, problems, ideas,
// initiatives, seed cases - stays as one `Seed` object in Company.seedJson, because
// src/features/cases/reducer.ts takes `reduce(seed, log)` and needs that shape verbatim.
// Normalising it would be weeks of work and would buy nothing the pilot needs.
//
// Note for Prisma 7: the datasource carries no `url`. Connection details live in
// prisma7.config.ts - `url = env("DATABASE_URL")` here is a validation error since v7.

generator client {
  // The classic generator: emits into node_modules/@prisma/client, so `@prisma/client` stays a
  // plain bare import. The newer "prisma-client" provider emits .ts into a path we would have to
  // add to .gitignore, which is Kevin's file. Worth revisiting when Prisma 8 lands.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One tenant. `slug` is the [company] URL segment and the subdomain label.
model Company {
  id   String @id @default(cuid())
  slug String @unique
  name String
  mark String @default("")

  // Per-company product rules (docs/PLAN.md "decisions before Phase 2", #3).
  anonymousHandles Boolean @default(true)

  // demo | sandbox | pilot | live - docs/INTEGRATIONS.md "Stages". A customer's phase is a flag
  // set, not a branch.
  stage String @default("demo")

  // scrypt$<saltHex>$<hashHex>. The pilot's shared company code. No longer a way in: people sign
  // in with their own User.loginCodeHash or Microsoft. Nullable so new companies need none; kept
  // until the old rows are gone, then dropped.
  accessCodeHash String?

  // "Continue with Microsoft": the company's Entra tenant ID (a GUID). Null = Microsoft sign-in
  // off for this company. Only accounts from this tenant get in - src/features/auth/entra.ts.
  entraTenantId String?

  // The demo clock, and the reason it is a column rather than a derived value: reducer.ts reads
  // `log.day` directly (`const day = log.day | 0`) and never replays day.advanced. So EventLog.day
  // has to be materialised somewhere, and it is here. A day.advanced row still gets written - it
  // is the audit trail - and it bumps this in the same transaction.
  demoDay Int @default(0)

  // One `Seed` (src/features/demo/types.ts), verbatim. Cloned from a template when the company is
  // created in /admin.
  seedJson Json

  createdAt DateTime @default(now())

  config CompanyConfig?
  users  User[]
  events CaseEvent[]
  tokens ApiToken[]

  profile  CompanyProfile?
  orgUnits OrgUnit[]
  orgRoles OrgRole[]
  holders  OrgRoleHolder[]
  rules    RoutingRule[]
  goals    Goal[]
}

// ── Company knowledge ────────────────────────────────────────────────────────────────────────────
// What the company IS, as facts a department head edits now and then and an AI can read and cite:
// profile, org units, roles, the routing table, goals. docs/COMPANY_KNOWLEDGE.md has the why.
//
// Roles, not people (PRODUCT_CONCEPT_ORG_OS.md §5.3, CONCEPT_CHECK_SEP13.md §4): the hierarchy,
// decision rights and skills hang off OrgRole. A person appears only as an OrgRoleHolder, so the
// model can be handed the structure without a single name in it.
//
// While seedJson still exists, src/features/knowledge projects these rows back into Seed.depts /
// people / routes, so reduce(seed, log) keeps its shape. A company with no OrgUnit rows is read
// from seedJson exactly as before.

// Vision, mission and the like. Short text, one row per company.
model CompanyProfile {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  vision        String   @default("")
  mission       String   @default("")
  principles    String[]
  businessModel String   @default("")

  updatedAt DateTime @updatedAt
  updatedBy String? // display name of whoever saved it last
}

// A department, team or board. `key` is the id the seed and the event log already use ("PRD").
model OrgUnit {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  key       String
  name      String
  kind      String  @default("dept") // board | dept | team
  headcount Int     @default(0)
  parentId  String?
  parent    OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  OrgUnit[] @relation("OrgUnitTree")
  sort      Int       @default(0)

  roles OrgRole[]
  goals Goal[]

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([companyId, key])
}

// A position: "Head of Production", "Line 3". The hierarchy is between roles.
model OrgRole {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orgUnitId   String
  orgUnit     OrgUnit   @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  title       String
  reportsToId String?
  reportsTo   OrgRole?  @relation("RoleTree", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     OrgRole[] @relation("RoleTree")

  decides       String[] // decision rights in words: "spend under €5k", "shift plan"
  spendLimitEur Int? // null = no own spend authority on record
  skills        String[] // what the ROLE needs - never a per-person profile (BetrVG §87)
  sort          Int      @default(0)

  holders OrgRoleHolder[]
  owns    RoutingRule[]   @relation("RuleOwner")
  deputy  RoutingRule[]   @relation("RuleDeputy")
  buddy   RoutingRule[]   @relation("RuleBuddy")

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([companyId])
}

// Who holds a role. The only place a person's name meets the structure. `userId` is set when the
// person can sign in; many holders (people in the org chart) never do.
model OrgRoleHolder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  roleId String
  role   OrgRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  name   String
  userId String?
  sort   Int     @default(0)

  @@unique([roleId, name])
  @@index([companyId])
}

// One row of the routing table (§19): request type -> owning role · deputy role · buddy role.
// `key` is Seed.Route.id ("r1"), which cases and events already point at.
model RoutingRule {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  key          String
  type         String
  keywords     String[]
  ownerRoleId  String
  owner        OrgRole  @relation("RuleOwner", fields: [ownerRoleId], references: [id], onDelete: Cascade)
  deputyRoleId String?
  deputy       OrgRole? @relation("RuleDeputy", fields: [deputyRoleId], references: [id], onDelete: SetNull)
  buddyRoleId  String?
  buddy        OrgRole? @relation("RuleBuddy", fields: [buddyRoleId], references: [id], onDelete: SetNull)
  wait         String   @default("") // "3 d" - display text until the promise clock is per rule
  sort         Int      @default(0)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([companyId, key])
}

// A company goal, or a unit's goal under it. `keywords` feed the matcher in features/evaluate
// until a model replaces it.
model Goal {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orgUnitId String? // null = a company-wide goal
  orgUnit   OrgUnit? @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Goal?    @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Goal[]   @relation("GoalTree")

  title    String
  kpi      String   @default("")
  target   String   @default("")
  period   String   @default("") // "2026", "Q4 2026"
  keywords String[]
  sort     Int      @default(0)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([companyId])
}

// Which integrations are on for this company. docs/INTEGRATIONS.md: flipped only by an event, so
// the change is a fact with an actor, not a silent edit.
model CompanyConfig {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  aiRouting     Boolean @default(false)
  n8n           Boolean @default(false)
  notifications Boolean @default(false)
  demoData      Boolean @default(true)
}

// A person who can sign in. `role` is a plain String, not an enum, because the three roles are
// data in src/config/roles.ts (Kevin's file) and an enum here would be a second source of truth.
model User {
  id        String @id @default(cuid())
  companyId String

  name String
  // Must match a name used in the company's seedJson (a persona, a route owner, or a row in
  // people[]) or derive.ts's visibleTo()/inboxFor() match nothing and the inbox renders empty
  // with no error. The admin create-company action checks this and warns.

  email String
  role  String // manager | leader | member - see src/config/roles.ts
  dept  String @default("")
  line  String @default("") // "Team lead · Production, 4-series" - persona.who.line
  ini   String @default("")

  handle String? // anonymous handle for members, e.g. "Anonymous #4471"

  // Personal login code: sha256 of it (src/features/auth/login-code.ts). Unique across ALL
  // companies because the login finds the person from the code alone. Null = no code issued.
  loginCodeHash String?   @unique
  loginCodeAt   DateTime? // when the current code was issued - shown in /admin, never the code

  // Microsoft's object id for this person, bound on their first Microsoft sign-in (matched by
  // email then). After that the account is matched by this, which Microsoft never reassigns.
  entraOid String?

  createdAt DateTime @default(now())

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events  CaseEvent[]

  @@unique([companyId, email])
  @@unique([companyId, entraOid])
  @@index([companyId, name])
}

// The event log - one row per appended fact. "Events, not edits": nothing here is ever updated.
//
// What is NOT in this table: seed history. Those events live inside seedJson (SeedCase.seedEvents)
// and reducer.ts synthesises them with seed:true before replaying these rows. Keeping them out
// means "reset this company" is a delete of these rows and nothing else.
model CaseEvent {
  // Minted by the client (newId("e")) so an optimistic UI can dedupe, and so a retried server
  // action collides on the primary key instead of writing a second row.
  id String @id

  // The cursor for GET /api/[company]/events?since=. Int, not BigInt: BigInt does not survive
  // JSON.stringify and would leak into the route handler and the client.
  seq Int @unique @default(autoincrement())

  companyId String

  ts  DateTime @default(now())
  day Int // Company.demoDay when this was written - matches appendEvent(), which stamps the day
  // it left, before day.advanced moves the clock.

  type        String // CaseEventType - src/features/cases/events.ts
  actor       String // display name or handle; what reduce() reads
  actorUserId String? // real identity behind the actor; null for "system:n8n"
  targetId    String? // case id, idea id, or null (day.advanced)
  payload     Json

  source String  @default("app") // app | n8n | admin
  idemKey String? // integration idempotency key; a replay is a 200 with no new row

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorRef User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  // Ordering is by seq, never by ts: ts ties at millisecond resolution and the reducer is
  // order-sensitive (a hand-over then an answer is not the same as the reverse).
  @@index([companyId, seq])
  @@index([companyId, targetId])
  // Postgres treats NULLs as distinct, so the many rows with no idemKey do not collide.
  @@unique([companyId, idemKey])
}

// A bearer token for one company's integration endpoints. docs/INTEGRATIONS.md: a token for
// company A used against company B is a 403, and that is a test.
model ApiToken {
  id        String @id @default(cuid())
  companyId String

  name   String
  hash   String   @unique // sha256(raw token), hex. The raw token is shown once and never stored.
  scopes String[] // ["events:read", "events:write"]

  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// A pilot request from the public /contact form. Not a tenant table: the company named here is
// free text typed by a stranger, not a Company row - it becomes one only when someone in /admin
// decides so. Nothing is ever updated except `handledAt`, which is the one fact worth recording.
model PilotRequest {
  id String @id @default(cuid())

  name     String
  company  String
  email    String
  decision String
  council  String // no | yes | not sure - src/features/pilot/request.ts
  message  String @default("")

  createdAt DateTime  @default(now())
  handledAt DateTime?

  // Ours, never shown to the person who wrote in: what we know, what was agreed on the phone.
  notes   String       @default("")
  replies PilotReply[]

  @@index([createdAt])
}

// One answer sent (or logged as sent) from /admin/requests. Kept so the panel shows the thread,
// not just a "replied" timestamp; goes with its request on delete.
model PilotReply {
  id        String       @id @default(cuid())
  requestId String
  request   PilotRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  to      String
  subject String
  body    String
  via     String // smtp | manual - features/admin/reply.ts
  sentAt  DateTime @default(now())

  @@index([requestId, sentAt])
}
