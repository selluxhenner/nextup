# Copy to .env.local - never commit .env.local (see .gitignore).
# DATABASE_URL is live as of the Prisma schema; the rest still arrive with sessions and tenancy.
#
# Prisma 7 note: the connection string is read by prisma7.config.ts, not by schema.prisma
# (`url = env(...)` in a datasource is a validation error since v7). The CLI loads .env.local
# itself, so `npx prisma migrate dev` works without exporting anything.
#
# Leave DATABASE_URL unset to run against the built-in demo tenant with no database at all -
# `npm run dev`, `npm test` and `npm run build` all work that way, which is how CI runs. A set
# DATABASE_URL that nothing answers at (no Docker) falls back to the same demo, with a warning.
# 127.0.0.1, not localhost: Node resolves localhost to ::1 first and Docker Desktop publishes
# the port on IPv4 only, so a `localhost` URL fails with "Can't reach database server at ::1".
DATABASE_URL="postgresql://nextup:nextup@127.0.0.1:5432/nextup"
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
# How a company is addressed. Subdomain mode is what the compose stack serves.
#   path      -> nextup.serviweb.ch/acme/...
#   subdomain -> acme.nextup.serviweb.ch/...
TENANT_MODE="path"

# ── Self-hosting (ops/, compose.yml) ─────────────────────────────────────────
# Copy this file to .env on the box (compose reads .env; Next reads .env.local).
# Laptop: APP_DOMAIN=localhost, CADDYFILE=Caddyfile.dev, PUBLIC_SCHEME=http, COOKIE_SECURE=false
# VPS:    APP_DOMAIN=nextup.serviweb.ch, CADDYFILE=Caddyfile, PUBLIC_SCHEME=https, COOKIE_SECURE=true
APP_DOMAIN="localhost"
CADDYFILE="Caddyfile.dev"
PUBLIC_SCHEME="http"
COOKIE_SECURE="false"

# Postgres password for the compose stack. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD="change-me"

# Opens /admin, where companies are created. Generate one: openssl rand -base64 24
ADMIN_ACCESS_CODE="change-me"

# Demo boxes only: puts a "Demo code" button in the /admin login field that fills
# ADMIN_ACCESS_CODE in one click. It ships the code to the browser in the page source -
# leave it unset anywhere the admin area is worth protecting.
ADMIN_DEMO_FILL="false"

# Demo boxes only: a "Demo code" button on each company's login and a pretend
# "Continue with Microsoft" (no Microsoft behind it - you pick one of the company's people).
# Both use a demo code derived from AUTH_SECRET, which then opens that company. It ships the
# code to the browser - leave it unset anywhere real people log in.
LOGIN_DEMO_FILL="false"

# Only for the production Caddyfile (wildcard cert via DNS-01 at hosttech).
# Leave both empty and use CADDYFILE=Caddyfile.ondemand to run without any DNS credentials.
ACME_EMAIL=""
HOSTTECH_API_TOKEN=""

# Where the app tells n8n a case was raised. A service name - never the public internet.
N8N_HOOK_URL="http://n8n:5678/webhook/nextup/case-raised"
N8N_HOOK_TOKEN="change-me"

# Lets /admin send replies to pilot requests itself. Unset = "open in your mail app" + log it.
# Dev: mailpit's SMTP port (publish 1025 in compose.local.yml); the compose stack uses mailpit:1025.
# Real relay: smtp://user:pass@smtp.example.com:587 (or smtps://...:465).
SMTP_URL="smtp://127.0.0.1:1025"
MAIL_FROM="NextUp <hello@nextup.serviweb.ch>"
